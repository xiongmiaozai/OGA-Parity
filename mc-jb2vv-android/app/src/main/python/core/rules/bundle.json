{
  "rules_version": "2026.11.13-2",
  "engine_min_version": [
    1,
    21,
    120
  ],
  "manifest_format_version": 2,
  "manifest_v2_required_when_engine_at_least": [
    1,
    13,
    0
  ],
  "capability_whitelist": [
    "pbr"
  ],
  "capability_blacklist": [
    "raytraced",
    "raytracing"
  ],
  "texture_set_format_version": "1.21.30",
  "texture_set_fallback_version": "1.16.100",
  "mip_friendly_sizes": [
    16,
    32,
    64,
    128,
    256,
    512,
    1024,
    2048,
    4096
  ],
  "bump_strategies": [
    "normal",
    "heightmap"
  ],
  "packed_strategies": [
    "mer"
  ],
  "normal_flat_baseline": [
    128,
    128,
    255
  ],
  "atlas_padding": 8,
  "atlas_num_mip_levels": 4,
  "materialize_bedrock_aliases": true,
  "uniform_constant_layers": {
    "enabled": true,
    "mer_std_threshold": 32,
    "mer_neutral_max": 8,
    "omit_flat_inferred_normal": true,
    "omit_near_flat_real_normal": true,
    "normal_flat_tilt_max": 0.28,
    "normal_flat_p95_max": 0.35,
    "normal_detail_tilt": 0.3,
    "normal_detail_frac_max": 0.02,
    "note": "官方 Texture Sets 允许用 uniform 数组值替代整张纯色层；纯常量 MER 写成 [R,G,B]，原包无 _n 时推断出的纯平面法线直接省略（normal 层不支持 uniform，缺失时回退 vanilla）。真实 _n 只有在『整体平坦 mean_tilt<=normal_flat_tilt_max』且『局部无强细节 p95_tilt<=normal_flat_p95_max』且『强细节像素占比<=normal_detail_frac_max』三者同时成立时，才判定为会产生 VV 蓝紫伪影的近平面法线并省略回退 vanilla。复合判据避免『大面积平坦+边缘有细节』的木板/树叶/原木顶被均值误杀（v2026.11.13-1，此前仅用均值导致 79.4% 误杀、画面明显变平）。"
  },
  "icon_rename": {
    "enabled": true,
    "target": "pack_icon.png",
    "candidates": [
      "pack.png"
    ],
    "prefer_pack_root": true,
    "require_png_magic": true
  },
  "convertible_texture_dirs": {
    "block": "blocks",
    "blocks": "blocks",
    "item": "items",
    "items": "items",
    "entity": "entity",
    "particle": "particle"
  },
  "texture_dir_priority": {
    "block": 0,
    "blocks": 1,
    "item": 0,
    "items": 1,
    "entity": 2,
    "particle": 3
  },
  "constraints": {
    "color_required": true,
    "normal_heightmap_mutually_exclusive": true,
    "mer_mers_mutually_exclusive": true,
    "heightmap_forbidden_categories": [
      "items",
      "entity",
      "particle"
    ],
    "reference_must_exist_in_pack": true,
    "reference_must_be_extensionless": true,
    "extension_priority": [
      ".tga",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  },
